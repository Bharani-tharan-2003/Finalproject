{
  "name": "smartvital-healthcare",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "Health_care",
    "Health_care/backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd Health_care && npm run dev",
    "dev:backend": "cd Health_care/backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd Health_care && npm run build",
    "build:backend": "cd Health_care/backend && npm run build",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "cd Health_care && npm run preview",
    "start:backend": "cd Health_care/backend && npm run start"
  },
  "dependencies": {
    "axios": "^1.3.5",
    "class-variance-authority": "^0.6.1",
    "clsx": "^1.2.1",
    "date-fns": "^2.30.0",
    "envalid": "^8.0.0",
    "lucide-react": "^0.263.1",
    "mysql2": "^3.14.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.5.3",
    "recharts": "^2.15.3",
    "sequelize": "^6.37.7",
    "sonner": "^0.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "sweetalert2": "^11.19.1",
    "tailwind-merge": "^1.13.2",
    "tailwindcss-animate": "^1.0.6",
    "xlsx": "^0.18.5",
    "@radix-ui/react-alert-dialog": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^1.2.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.0.6",
    "@reduxjs/toolkit": "^2.7.0",
    "@tanstack/react-query": "^4.29.5",
    "@types/react-redux": "^7.1.34"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.3.1",
    "typescript": "^5.0.3",
    "vite": "^4.3.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
